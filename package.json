{
  "name": "kargul-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "extract:avif": "bash scripts/extract_webm_frames.sh",
    "to:avif": "node scripts/to-avif.mjs",
    "frame:rive": "node scripts/rive-frame.mjs",
    "test:workflow": "tsc data/media.ts lib/media-workflow.ts tests/media-workflow.test.ts --outDir /tmp/media-workflow-tests --module commonjs --target ES2022 --esModuleInterop --skipLibCheck --strict && node --test /tmp/media-workflow-tests/tests/media-workflow.test.js && node --test tests/media-store.test.cjs",
    "test:server": "node --test tests/server.test.cjs",
    "verify": "next typegen && tsc --noEmit && eslint && npm run test:workflow && npm run test:server && npm run test:drive && npm run test:import && npm run test:lifecycle && npm run test:db && next build",
    "test:db": "node --test tests/db-import.test.mjs",
    "db": "node scripts/db.mjs",
    "test:drive": "node --test tests/drive.test.cjs",
    "test:import": "node --test tests/import.test.cjs",
    "test:lifecycle": "node --test tests/lifecycle.test.cjs"
  },
  "dependencies": {
    "@rive-app/canvas": "^2.31.0",
    "@rive-app/react-canvas": "^4.31.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "lottie-react": "^2.4.1",
    "motion": "^12.23.22",
    "next": "^16.3.0",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "photoswipe": "^5.4.4",
    "pptxgenjs": "^4.0.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-use-measure": "^2.1.7",
    "swiper": "^12.0.2",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "^2.0.4"
    },
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
