# Copy into .env.local. Never commit the completed file or private keys.
# Durable storage: must be a writable persistent volume on ONE Node host.
# Leave empty to use .media-data in the project; any custom path must be absolute.
# Example: MEDIA_DATA_DIR=/var/lib/internal-comms
MEDIA_DATA_DIR=

# Development defaults to a clearly labelled demo when no accounts are configured.
# Production is closed until root is bootstrapped or legacy credentials are configured.
# A bootstrapped root ALWAYS disables demo, even if this is true.
MEDIA_DEMO_MODE=false

# Legacy environment authentication (optional). Local account management uses a private
# durable registry and signing key instead. Bootstrap with scripts/setup-root-account.cjs
# reading the password from stdin; then manage passwords in the admin screen.
# Managed local accounts take precedence over these legacy settings.
# For legacy auth, generate a random secret of at least 32 characters.
MEDIA_SESSION_SECRET=
# Account IDs must match active team members in the administrator screen.
# Password hash format: scrypt:<32+-character salt hex>:<128-character derived key hex>.
# Never place plaintext passwords here. See docs/internal-comms-server.md.
MEDIA_AUTH_USERS=
# Optional fixed public origin when the app sits behind a reverse proxy.
# MEDIA_APP_ORIGIN=https://internal.example.com

# Google Drive archive browsing and optional upload of delivered final originals.
# Enable Google Drive API and share the chosen folder with this service-account email.
# Reader access is enough to browse. Archiving needs writer access; use a Shared Drive.
# Set the folder ID in the system administration screen, not in this file.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the service-account private_key; escaped \n line breaks are supported.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
